{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-setup-guide",
  "account_id": "89b0e4ee68c1b33f1f5fc3c8db11c9f5",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "routes": [
    { "pattern": "botsetupguide.com/*", "zone_name": "botsetupguide.com" },
    { "pattern": "www.botsetupguide.com/*", "zone_name": "botsetupguide.com" }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}